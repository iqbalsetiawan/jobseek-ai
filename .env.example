# Bearer token for https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_API_TOKEN=

# Optional. Model id for chat completions (default: meta-llama/Llama-3.1-8B-Instruct)
HUGGINGFACE_MODEL=

# Optional. Canonical site URL for metadata and OG (no trailing slash).
# Falls back to VERCEL_URL, then http://localhost:3000
NEXT_PUBLIC_SITE_URL=
